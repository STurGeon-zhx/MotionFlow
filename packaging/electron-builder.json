{
  "appId": "com.motionflow.desktop",
  "productName": "MotionFlow",
  "directories": {
    "output": ".release/installer",
    "app": ".data/installer-shell"
  },
  "files": [
    "package.json",
    "packaging/**/*",
    "!**/node_modules/**"
  ],
  "extraMetadata": {
    "main": "packaging/electron-main.cjs"
  },
  "extraFiles": [
    {
      "from": ".data/installer-runtime",
      "to": "_internal"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "electronVersion": "44.3.0",
  "electronDist": "node_modules/electron/dist",
  "artifactName": "MotionFlow-Setup-${version}-Windows-${arch}.${ext}",
  "afterPack": "packaging/after-pack.cjs"
}
