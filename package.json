{
  "name": "motion-batch-studio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"tsx server.ts\" \"tsx watch src/worker.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c blue,magenta \"tsx server.ts --production\" \"tsx src/worker.ts\"",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "render:smoke": "tsx scripts/render-smoke.ts",
    "render:sequence-smoke": "tsx scripts/render-sequence-smoke.ts",
    "render:benchmark": "tsx scripts/render-throughput-benchmark.ts",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "package:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "desktop:review": "node scripts/start-desktop-review.mjs",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "render:review-benchmark": "tsx scripts/benchmark-local-review.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.518",
    "@remotion/player": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.518",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
